# ... (all the other ignores from the previous template)

# --- Project-Specific Ignores ---
# Ignore datasets, large files, and media
###########################################
data/images/

# --- General ---
# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages #
############
# DPKG packages
*.deb

# Compressed files #
####################
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip


# --- System ---
# Ignore OS-generated files #
#############################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db


# --- Development ---
# Ignore environment variables #
################################
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore dependency directories #
#################################
/node_modules/
/vendor/

# Ignore log and build files #
##############################
/build/
/dist/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore IDE/editor configuration files #
#########################################
.idea/
.vscode/
*.sublime-project
*.sublime-workspace